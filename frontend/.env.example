# CRM dashboard — must use the SAME PostgreSQL database as the Digital Menu
# so kitchen orders from the menu appear on this CRM dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3001"
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
# Deployed Digital Menu URL
NEXT_PUBLIC_SITE_URL="https://nfc-digital-menu.vercel.app/"
